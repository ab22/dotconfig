# Global git ignore (canonical: dotconfig/root/.gitignore)
#
# Linked to ~/.gitignore and wired in by `task install` with:
#   git config --global core.excludesFile ~/.gitignore
#
# It applies to EVERY repository on this machine — which is the point: the
# per-repo agent overlay and other machine-local context files must never be
# committed to a shared repo. `git check-ignore -v <path>` names the rule
# responsible, in any repo.

# --- machine-local agent context -------------------------------------------------
# The per-repo overlay: switches and rule files for this machine only.
# See AI/AGENTS.md ("What loads, and in what order").
.agents/local.md
AGENTS.local.md
CLAUDE.local.md

# Claude Code's local state; skills under .claude/skills/ stay shareable.
.claude/*
!.claude/skills/
!.claude/skills/**

# --- editors ---------------------------------------------------------------------
.vscode/
.idea/
.zed/
.obsidian
*.swp
*.swo

# --- build noise -----------------------------------------------------------------
*.log

# --- OS noise --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
